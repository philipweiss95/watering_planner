# Copy this file to .env.synology on the NAS and keep the real webhook private.
HOME_ASSISTANT_WEBHOOK_URL=http://HA-IP:8123/api/webhook/REPLACE_WITH_RANDOM_WEBHOOK_ID
HOME_ASSISTANT_REFILL_WEBHOOK_URL=http://HA-IP:8123/api/webhook/REPLACE_WITH_RANDOM_REFILL_WEBHOOK_ID

# Optional SMTP notifications. Secrets stay server-side and are never exposed
# through the browser API.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=watering-planner@example.com
SMTP_TO=owner@example.com
SMTP_SECURITY=starttls

# Set only in tests or short-lived diagnostic processes.
NOTIFICATION_WORKER_DISABLED=false
